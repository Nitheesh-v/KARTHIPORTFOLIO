# ------------------------------------------------------------------
# Copy this file to  Backend/.env  and fill in your own values.
# NEVER commit the real .env file.
# ------------------------------------------------------------------

# --- Server ---
NODE_ENV=development
PORT=5000
# Comma separated list of frontend URLs allowed to call this API
CLIENT_ORIGINS=http://localhost:5173

# --- MongoDB ---
# PASTE YOUR REAL URI IN Backend/.env  (NOT in this .env.example file -
# .env.example is committed to GitHub, .env is git-ignored).
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net
# Local:  mongodb://127.0.0.1:27017
MONGO_URI=
DB_NAME=portfolio

# --- SMTP / Email ---
# Gmail: enable 2-Step Verification, then create an App Password
# https://myaccount.google.com/apppasswords
# SMTP_USER  = the Gmail address that SENDS (usually your own)
# SMTP_PASS  = the 16-character App Password, paste it WITHOUT spaces
#              ("abcd efgh ijkl mnop"  ->  "abcdefghijklmnop")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_16_char_app_password
# Inbox that should receive the contact form messages
MAIL_TO=karthickr2304@gmail.com
MAIL_FROM_NAME=Portfolio Contact Form

# --- Admin (to read stored messages via GET /api/contact) ---
ADMIN_API_KEY=change_this_to_a_long_random_string
