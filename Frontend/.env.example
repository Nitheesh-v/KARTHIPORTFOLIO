# Base URL of the backend API.
# Leave it EMPTY in development - the Vite proxy forwards /api to localhost:5000.
# In production put your deployed backend URL here, e.g.
# VITE_API_BASE_URL=https://karthi-portfolio-api.onrender.com
VITE_API_BASE_URL=

# Set to true to run the contact form against local mock data
# (no backend needed - useful for UI demos and offline work)
VITE_USE_MOCK_API=false
